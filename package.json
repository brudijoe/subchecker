{
  "name": "subchecker",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm --prefix subchecker-backend run dev\" \"npm --prefix subchecker-web-app run dev\"",
    "dev:backend": "npm --prefix subchecker-backend run dev",
    "dev:frontend": "npm --prefix subchecker-web-app run dev",
    "openapi:types": "openapi-typescript subchecker-backend/openapi.yaml -o subchecker-web-app/src/api/generated/openapi.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "concurrently": "^9.2.1"
  }
}
